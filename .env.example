# Linda Donkers website: environment variables
# Local: copy to .env.local. Production: add them in Vercel -> Project -> Settings -> Environment Variables.

# Public URL, used in emails and Stripe redirects (no trailing slash)
SITE_URL=https://www.lindadonkers.com

# Admin panel (/admin): Linda's passcode, at least 8 characters
ADMIN_PASSCODE=

# Database: Turso (https://turso.tech, free tier). Leave empty locally to use ./data/linda.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Stripe (https://dashboard.stripe.com/apikeys). Use sk_test_... until everything is tested.
STRIPE_SECRET_KEY=
# Developers -> Webhooks -> endpoint https://www.lindadonkers.com/api/stripe-webhook -> "Signing secret"
STRIPE_WEBHOOK_SECRET=

# Resend (https://resend.com/api-keys). Verify lindadonkers.com in Resend -> Domains first.
RESEND_API_KEY=
EMAIL_FROM=Linda Donkers <bookings@lindadonkers.com>
# Where Linda receives "new booking" / "cancelled" emails
ADMIN_EMAIL=info@lindadonkers.com

# Linda's WhatsApp number, international format without "+"
LINDA_WHATSAPP=32498142845

# Customer login (memberships) through Supabase Auth: https://supabase.com/dashboard
# Project Settings -> API Keys: the project URL and the PUBLISHABLE key (sb_publishable_..., or the legacy "anon" key).
# Both are public and safe in the browser. Never put the secret / service_role key here: it isn't needed.
# The VITE_ prefix makes them available to the website; the API reads the same variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
